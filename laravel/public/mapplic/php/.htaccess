# Scripts legados SUSTITUIDOS por la API Laravel (/api/...). Se responde 410 Gone para que nadie use las versiones
# antiguas, que son inyectables o exponen datos (SEC-01/03/04/05/06). Ver GUIA_CONMUTACION_FRONTEND.md, punto 10.
# OJO: chat.php y «chat copy.php» NO se bloquean aquí (decisión del responsable: el chat legado queda como está).
<IfModule mod_rewrite.c>
    RewriteEngine On
    # [G] = 410 Gone; [NC] = sin distinguir mayúsculas.
    RewriteRule ^(iniciarSesion|cambiarAvatar|consultarInfo|buscarPreguntas)\.php$ - [G,NC]
</IfModule>

# Respaldo si mod_rewrite no está cargado: denegar el acceso (403) a esos mismos archivos.
<IfModule !mod_rewrite.c>
    <FilesMatch "^(iniciarSesion|cambiarAvatar|consultarInfo|buscarPreguntas)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>
