# ---------------------------------------------------------------------------------------------------------------
# Explora: configuración de Apache del ÚNICO documento raíz del sitio (DocumentRoot = laravel/public).
# Requiere AllowOverride All y mod_rewrite. Guía completa: DOCUMENTACION_MEJORAMIENTO/DESPLIEGUE_APACHE.md
#
# Como laravel/.env, vendor/, storage/ y la documentación quedan FUERA del docroot, ya no hace falta un .htaccess
# en la raíz del repositorio para ocultarlos (Fase 9). Aquí solo quedan las reglas de seguridad del propio sitio.
# ---------------------------------------------------------------------------------------------------------------

# Sin listado de directorios (evita exponer el contenido de carpetas sin index) y sin negociación de contenido
# (MultiViews haría que /api/x resolviera a un archivo x.* por sorpresa).
Options -Indexes -MultiViews

# La raíz «/» la atiende Laravel (la portada es la vista `inicio`, Fase 11): index.php va PRIMERO. Las carpetas
# del sitio estático con su propio index.html siguen sirviéndolo, porque allí no hay index.php. (`/juegos/` ya no es
# una de ellas desde la Fase 12: la atiende Laravel mediante la regla `^juegos/?$` de más abajo.)
DirectoryIndex index.php index.html

# Nunca servir el repositorio Git ni archivos .env (credenciales), en cualquier nivel de la ruta. Defensa en
# profundidad: ninguno debería existir bajo el docroot.
RedirectMatch 404 /\.(git|env)

# Los archivos de conexión del PHP legado contienen credenciales de MySQL escritas en el código.
<FilesMatch "^conexion.*\.php$">
    Require all denied
</FilesMatch>

# Volcados, copias y archivos de proyecto que nunca deben descargarse.
<FilesMatch "\.(sql|gz|zip|md|sh|lock|log|bak)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Portal de juegos (Fase 12): /juegos y /juegos/ son una CARPETA real (guarda css/, js/, juegos/…), así que las
    # reglas genéricas de abajo (`!-d`) no la enviarían a Laravel. Esta regla manda EXACTAMENTE esas dos URL al
    # front controller (`^juegos/?$` no coincide con /juegos/css/…, /juegos/juegos/… ni /juegos/js/) y va ANTES de
    # DirectoryIndex/mod_dir, que de otro modo redirigiría /juegos a /juegos/ y no encontraría index.html.
    # No habilita listados de directorio: el resto de carpetas sin index siguen dando 403 por `-Indexes`.
    RewriteRule ^juegos/?$ index.php [L]

    # Páginas de los 7 juegos (Fase 13): cada una es una CARPETA real (JS, CSS, JSON, sonidos…) sin index.html desde que
    # su HTML pasó a Blade, así que las reglas genéricas (`!-d`) no la enviarían a Laravel. Esta regla manda al front
    # controller EXACTAMENTE `/juegos/juegos/<slug>/` y `/juegos/juegos/<slug>` (la ruta de Laravel redirige 301 la forma
    # sin barra, porque el JS del juego resuelve sus archivos relativos a la URL CON barra). Con Apache real mod_dir podría
    # haber redirigido antes a la forma con barra: es equivalente. No afecta a los archivos de esas carpetas (el patrón
    # termina en el slug) y no habilita listados (`-Indexes` sigue vigente). La lista debe coincidir con config/juegos.php:
    # lo vigila tests/Feature/JuegosPaginasTest. `/juegos/juegos/<slug>/index.html` ya no existe y cae en la regla genérica.
    RewriteRule ^juegos/juegos/(laberinto|banderas-color|puzzle|sopa_letras|juego_ahorcado|arrastra|completa)/?$ index.php [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Front controller de Laravel: todo lo que no sea un archivo o carpeta real (p. ej. /api/...) lo atiende
    # index.php, que ve la ruta COMPLETA con el prefijo «api».
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
