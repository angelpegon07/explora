APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Plataforma pednia/ambientes (solo lectura)
PEDIGITAL_DB_HOST=127.0.0.1
PEDIGITAL_DB_PORT=3306
PEDIGITAL_DB_DATABASE=pedigital
PEDIGITAL_DB_USERNAME=
PEDIGITAL_DB_PASSWORD=

# --- Ajustes propios de Explora (ver README.md, sección «Variables de entorno») ---
# Cookie de sesión solo por HTTPS. Poner true en cualquier entorno con HTTPS (obligatorio en producción).
SESSION_SECURE_COOKIE=false
# Hosts ADICIONALES aceptados en la cabecera `Host`, separados por comas (nombres exactos, sin esquema ni puerto; p. ej. el alias
# `www.`). El host de APP_URL siempre se acepta; cualquier otro Host da 400. En APP_ENV=local/testing también valen
# localhost, 127.0.0.1 y [::1]. En producción fije APP_URL con el dominio real. Ver app/Http/Middleware/TrustHosts.php.
TRUSTED_HOSTS=
# Otros orígenes permitidos por CORS, separados por comas. Vacío = solo el mismo origen (lo recomendado).
CORS_ALLOWED_ORIGINS=
# El quiz envía la respuesta correcta al navegador porque quiz.js corrige allí (SEC-06). NO poner false hasta
# que la corrección se haga en el servidor: con el cliente actual el quiz dejaría de funcionar.
QUIZ_INCLUIR_RESPUESTAS=true
# Cantidad de avatares disponibles (juegos/images/avatars/1.png … N.png).
AVATARES_MAX=35
# Memoria de PHP para la ruta de la ficha. 512M mientras las fichas lleven imágenes base64 (DAT-07); tras aplicar
# `php artisan explora:externalizar-imagenes` en producción y verificarlo, puede bajarse a 128M.
FICHAS_MEMORIA=512M
# Partidas que puede guardar cada usuario (o cada IP, si es invitado) por minuto.
RESULTADOS_POR_MINUTO=10
# Peticiones por minuto del grupo `api` por usuario o IP. Alto porque las aulas comparten IP por NAT (antes: 60).
API_POR_MINUTO=300

# --- Solo para pruebas: usuario MySQL con escritura ÚNICAMENTE sobre las bases *_test ---
# El NOMBRE es histórico (LEGACY_): hasta la Fase 15 lo usaba también el arnés del PHP legado, que ya se retiró. Hoy lo leen
# AutenticacionTest y PerfilPortalTest para preparar usuarios en pedigital_test (la conexión normal es de solo lectura).
# No renombrar sin migrar también esas pruebas. Nunca apuntar a bases reales.
LEGACY_DB_USER=
LEGACY_DB_PASS=

# Caché de lectura de la ficha y las preguntas (Fase 17B). TTL del servidor en segundos (0 = desactivada), segundos que el
# navegador la reutiliza sin preguntar, y mayor cuerpo (bytes) que se guarda en el servidor. Tras cambiar el contenido:
# `php artisan explora:limpiar-cache-lectura`.
EXPLORA_CACHE_TTL=3600
EXPLORA_CACHE_NAVEGADOR=300
EXPLORA_CACHE_MAX_BYTES=2097152

# Caché del ranking (Fase 17E): segundos en el servidor (0 = desactivada); guardar una partida la invalida al instante.
EXPLORA_RANKING_CACHE_TTL=30
