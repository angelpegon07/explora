# =====================================================================================================================
# Explora · .env de PRODUCCIÓN (plantilla sin secretos). Guía: DOCUMENTACION_MEJORAMIENTO/GUIA_DESPLIEGUE.md
#
# Cópiela a `<raíz>/.env` en el servidor, rellene TODO lo marcado «CAMBIAR» y proteja el archivo:  chmod 640, dueño = usuario del
# despliegue, grupo = usuario del servidor web. NUNCA se versiona ni se copia a un chat/correo. Tras cada cambio: `php artisan config:cache`
# (con la caché de configuración activa, Laravel NO relee este archivo). Las variables se leen solo desde config/*.php.
# =====================================================================================================================

# --- Aplicación -------------------------------------------------------------------------------------------------------
APP_NAME=Explora
# `production`: con `local` se aceptan hosts de desarrollo y con APP_DEBUG=true se muestran trazas.
APP_ENV=production
# La genera `php artisan key:generate --force` UNA vez en el servidor (cifra sesiones y cookies). No reutilizar la de otro entorno.
# Si cambia, se cierran todas las sesiones.
APP_KEY=
APP_DEBUG=false
# Dominio REAL con https://. Es el ÚNICO Host que acepta el middleware TrustHosts (cualquier otro da 400).
APP_URL=https://CAMBIAR-explora.example.org
# Alias adicionales (p. ej. www), nombres exactos separados por comas, sin esquema ni puerto. Vacío si no hay.
TRUSTED_HOSTS=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Base de datos `explora` (lectura de contenido + escritura de resultados y perfiles) ------------------------------------
# Contraseñas con `#`, espacios, `$` o comillas: póngalas entre COMILLAS SIMPLES ('clave con # y $'). Comprobado con el lector del .env:
# sin comillas, `ab#cd` se CORTA en silencio a `ab` (la conexión falla con «Access denied») y un espacio impide leer TODO el archivo
# (la aplicación responde 500). Lo más sencillo: contraseñas largas solo con letras y números.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=explora
# Usuario de MÍNIMO privilegio para el día a día (ver GUIA_DESPLIEGUE.md, «Usuarios MySQL»). El que tiene DDL se usa SOLO para migrar
# y externalizar imágenes, y NO se escribe aquí: se pasa por variables de entorno (DDL_DB_USERNAME/DDL_DB_PASSWORD, ver desplegar.sh).
DB_USERNAME=CAMBIAR_usuario_app
DB_PASSWORD=CAMBIAR_clave_larga_y_unica

# --- Base `pedigital` (usuarios; SOLO LECTURA) ---------------------------------------------------------------------------------
PEDIGITAL_DB_HOST=127.0.0.1
PEDIGITAL_DB_PORT=3306
PEDIGITAL_DB_DATABASE=pedigital
# Usuario con SELECT únicamente sobre pedigital.users.
PEDIGITAL_DB_USERNAME=CAMBIAR_usuario_pedigital_lectura
PEDIGITAL_DB_PASSWORD=CAMBIAR_otra_clave_larga_y_unica

# --- Sesión y caché ------------------------------------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
# OBLIGATORIO true con HTTPS (con false la cookie de sesión viaja también por HTTP). Solo vale false en un ensayo sin HTTPS.
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Ajustes propios de Explora (config/explora.php) -----------------------------------------------------------------------------
# Otros orígenes permitidos por CORS, separados por comas. Vacío = solo el mismo origen (lo recomendado).
CORS_ALLOWED_ORIGINS=
# El quiz corrige en el navegador y necesita recibir la respuesta correcta (SEC-06). NO poner false con el cliente actual.
QUIZ_INCLUIR_RESPUESTAS=true
AVATARES_MAX=35
# 512M mientras las fichas lleven imágenes base64; 128M tras ejecutar `explora:externalizar-imagenes` y verificarlo. Se aplica con
# ini_set en la ruta de la ficha: NO fije memory_limit con php_admin_value en el pool de PHP-FPM (lo impediría).
FICHAS_MEMORIA=512M
# Partidas guardables por usuario (o IP, si es invitado) por minuto.
RESULTADOS_POR_MINUTO=10
# Peticiones por minuto del grupo `api` por usuario o IP. Las aulas comparten IP por NAT: ajústelo al colegio (300 por defecto).
API_POR_MINUTO=300
# Caché de lectura de la ficha y las preguntas: segundos en el servidor (0 = desactivada), segundos en el navegador y mayor cuerpo
# (bytes) que se guarda. Requiere CACHE_DRIVER file/redis/database. Tras cambiar contenido: `php artisan explora:limpiar-cache-lectura`.
EXPLORA_CACHE_TTL=3600
EXPLORA_CACHE_NAVEGADOR=300
EXPLORA_CACHE_MAX_BYTES=2097152
# Caché del ranking en el servidor: segundos (0 = desactivada). Guardar una partida la invalida al instante.
EXPLORA_RANKING_CACHE_TTL=30

# CSP en modo informe (Fase 17F-C): true envía Content-Security-Policy-Report-Only (no bloquea nada); false la quita.
CSP_REPORT_ONLY=true
